VITE_API_URL=https://api.example.com
VITE_SOCKET_URL=wss://api.example.com
VITE_SOCKET_SECRET=your_socket_jwt_token
VITE_OTP_EXPIRE_TIME=120000
VITE_OFFICE_SERVER=https://office.example.com
VITE_CALLBACK_URL=https://api.example.com/api/v1/document/update
VITE_OFFICE_JWT_SECRET=your_onlyoffice_jwt_secret
VITE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
VITE_NEW_SITE_URL=https://new.example.com

# Frontend xatolarini Telegram'ga yuborish (@vath_hrm_logger_bot, "website" topic).
# Faqat production buildda ishlaydi (dev'da sinash uchun VITE_TG_LOG_ENABLED=true).
# Diqqat: token prod bundle ichida ochiq bo'ladi — bu bot faqat log guruhida tursin.
# chat_id va topic id ni topish: npm run telegram:info -- --token=<BOT_TOKEN>
VITE_TG_LOG_BOT_TOKEN=
VITE_TG_LOG_CHAT_ID=
VITE_TG_LOG_TOPIC_ID=
VITE_TG_LOG_ENABLED=

# ---------- FCM web push (Firebase loyihasi: das-uty-e3958) ----------
# VAPID: Firebase Console -> Project settings -> Cloud Messaging -> Web Push certificates
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
